# ─────────────────────────────────────────────────────────────────────────────
#  Pipeline demo — environment variables (docker compose)
#  Copy to `.env` and adjust before running `docker compose up`.
#  NEVER commit real credentials.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL database ──────────────────────────────────────────────────────
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=portfolio

# ── Host port bindings ───────────────────────────────────────────────────────
WEB_PORT=80          # Nginx (frontend + API gateway)
BACKEND_PORT=5000    # Express API (direct access, optional)

# ── Container image references (default: GHCR images pushed by CI) ───────────
# Set IMAGE_PREFIX for a fork / different GHCR namespace.
IMAGE_PREFIX=ghcr.io/yonialt/window-11-clone-
# Pin IMAGE_TAG to a specific commit SHA to roll back: IMAGE_TAG=<sha> docker compose up -d
IMAGE_TAG=latest

# ── Optional build metadata (injected by CI; leave as-is for local runs) ─────
COMMIT_SHA=local
BUILD_DATE=unknown

# ─────────────────────────────────────────────────────────────────────────────
#  GitHub Actions secrets (configure in the repo, NOT in .env):
#
#   DEPLOY_HOST        — production server IP/hostname
#   DEPLOY_USER        — SSH user (e.g. ubuntu, deploy)
#   DEPLOY_SSH_KEY     — private SSH key used to connect (deploy key)
#   DEPLOY_PORT        — SSH port (default 22)
#
#  GHCR authentication uses the built-in GITHUB_TOKEN — no secrets required.
# ─────────────────────────────────────────────────────────────────────────────
